{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/mcp.json", "destination": "/api/mcp-card" },
    { "source": "/.well-known/mcp-server", "destination": "/api/mcp-card" },
    { "source": "/.well-known/mcp/server-card.json", "destination": "/api/mcp-card" },
    { "source": "/llms.txt", "destination": "/api/llms" }
  ]
}